RHFilter.F_lower_large_epsilon {ε : ℝ} (hε : 1 / 2 ≤ ε) {x : ℝ} (hx : 0 < x) :
  -(5 / 2 * 4 ^ (1 / 2 + ε)) * x ^ (1 / 2 + ε) ≤ RHFilter.F x
RHFilter.Perron.minorant_of_analytic_steps (rh : RiemannHypothesis) {ε : ℝ} (he : 0 < ε) (he' : ε < 1 / 2)
  (tr : RHFilter.Perron.Truncation) (edges : RHFilter.Perron.EdgeEstimates ε) :
  ∃ C, 0 ≤ C ∧ ∀ (x : ℝ), 0 < x → -C * x ^ (1 / 2 + ε) ≤ RHFilter.F x
RHFilter.minorant_from_truncation_and_growth (rh : RiemannHypothesis) (tr : RHFilter.Perron.Truncation)
  (hg : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 → RHFilter.Perron.ReciprocalGrowth (1 / 2 + ε / 2) (ε / 2)) (ε : ℝ) :
  0 < ε → ∃ C, 0 ≤ C ∧ ∀ (x : ℝ), 0 < x → -C * x ^ (1 / 2 + ε) ≤ RHFilter.F x
